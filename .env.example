NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_API_BASE=https://guardian.16688.ccwu.cc/api
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://guardian:guardian_dev_password@postgres:5432/guardian
REDIS_URL=redis://redis:6379
DEV_ALLOW_FIXED_CAPTCHA=true
FIXED_CAPTCHA=123456
CORS_ORIGIN=https://guardian.16688.ccwu.cc
LOG_LEVEL=info
ADMIN_USERNAME=admin
# Prefer a bcrypt hash in production. ADMIN_PASSWORD is only a development fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-me-now
APP_VERSION=dev
UPDATE_REPOSITORY=dogwalkerg/guardian-backend
UPDATE_IMAGE=ghcr.io/dogwalkerg/guardian-backend:latest
UPDATE_ENABLED=true
UPDATE_REQUEST_PATH=/app/runtime/update-request.json
UPDATE_STATUS_PATH=/app/runtime/update-status.json
